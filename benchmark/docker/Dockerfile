# Benchmark container image.
#
# Reuses the devcontainer image (same toolchain: g++, clang-tidy, clang-format,
# uv, pyright) and adds an SSH server so the devcontainer can drive benchmark
# runs over SSH. The agent executes inside this container, which is the
# isolation boundary.
#
# Build context is the repository root (see run_container.sh), so the
# devcontainer Dockerfile is reachable at .devcontainer/Dockerfile.

# ---------------------------------------------------------------------------
# Stage 1: the devcontainer image, providing the proven benchmark toolchain.
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/devcontainers/python:3.12-trixie AS toolchain

ARG NODE_VERSION="lts/*"
RUN su vscode -c "source /usr/local/share/nvm/nvm.sh && nvm install ${NODE_VERSION} 2>&1"

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN apt-get update && apt-get install -y \
    clangd \
    clang-tidy \
    clang-format \
    ripgrep

RUN su vscode -c " \
    source /usr/local/share/nvm/nvm.sh && \
    npm install -g pyright \
"

# ---------------------------------------------------------------------------
# Stage 2: benchmark image — toolchain + sshd + non-root bench user.
# ---------------------------------------------------------------------------
FROM toolchain

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    rsync \
    && rm -rf /var/lib/apt/lists/*

# Non-root user the devcontainer connects as. The agent runs as this user.
RUN useradd --create-home --shell /bin/bash bench \
    && mkdir -p /home/bench/.ssh \
    && chmod 700 /home/bench/.ssh \
    && chown -R bench:bench /home/bench/.ssh

# Authorized public key for the devcontainer. Injected at build time via
# --build-arg BENCH_AUTHORIZED_KEY="$(cat benchmark/docker/id_ed25519.pub)".
ARG BENCH_AUTHORIZED_KEY=""
RUN if [ -n "$BENCH_AUTHORIZED_KEY" ]; then \
        printf '%s\n' "$BENCH_AUTHORIZED_KEY" > /home/bench/.ssh/authorized_keys \
        && chmod 600 /home/bench/.ssh/authorized_keys \
        && chown bench:bench /home/bench/.ssh/authorized_keys; \
    fi

# sshd runtime directory (regenerated by the entrypoint on each start).
RUN mkdir -p /run/sshd

# Harden sshd: key-only auth, no root login, and allow the bench user's
# ~/.ssh/environment (populated by the entrypoint) to reach SSH sessions.
RUN printf '%s\n' \
    'PasswordAuthentication no' \
    'PermitRootLogin no' \
    'PubkeyAuthentication yes' \
    'PermitUserEnvironment yes' \
    'AllowUsers bench' \
    > /etc/ssh/sshd_config.d/bench.conf

COPY benchmark/docker/entrypoint.sh /usr/local/bin/bench-entrypoint.sh
RUN chmod +x /usr/local/bin/bench-entrypoint.sh

EXPOSE 22

ENTRYPOINT ["/usr/local/bin/bench-entrypoint.sh"]
