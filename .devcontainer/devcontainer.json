{
  "name": "coding_agent",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // Run as the non-root user provided by the base image.
  "remoteUser": "vscode",

  // Mount the workspace at the standard location.
  "workspaceFolder": "/workspaces/coding_agent",

  // ---------------------------------------------------------------------------
  // Persist state that would otherwise live in the container's writable layer
  // and be lost on every rebuild:
  //
  //   .pi/agent     pi credentials, settings, sessions, skills, prompts
  //   vscode-user   VS Code user state: Copilot chat history (globalStorage),
  //                 per-workspace chat sessions (workspaceStorage), local file
  //                 history, snippets, user settings.json
  //   history       shell history, redirected here by
  //                 .devcontainer/shell-history.sh (HISTFILE)
  //
  // The host directories are created by initializeCommand before the
  // container starts, so Docker never creates root-owned bind sources. The
  // same script seeds them once from .devcontainer-state-export/, which holds
  // the state captured from the container before these mounts existed.
  // ---------------------------------------------------------------------------
  "initializeCommand": "sh ${localWorkspaceFolder}/.devcontainer/persist-init.sh ${localWorkspaceFolder}/.devcontainer-state-export",
  "mounts": [
    {
      "source": "${localEnv:HOME}/.pi/agent",
      "target": "/home/vscode/.pi/agent",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.devcontainer-state/coding_agent/vscode-user",
      "target": "/home/vscode/.vscode-server/data/User",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.devcontainer-state/coding_agent/history",
      "target": "/home/vscode/.history",
      "type": "bind"
    }
  ],
  "runArgs": [
        "--network=dev",
        "--add-host=host.docker.internal:host-gateway"
  ],

  // Post-create: install all Python dependencies (including dev group).
  // uv reads pyproject.toml and writes a .venv inside the workspace.
  //
  // The second step redirects bash history into the persisted mount and lifts
  // the default HISTSIZE/HISTFILESIZE (1000/2000 from the base image .bashrc).
  // Guarded by a marker so repeated creates do not append duplicates.
  // ---------------------------------------------------------------------------
  "postCreateCommand": "uv sync --all-groups && { grep -q devcontainer-shell-history ~/.bashrc || printf '\\n# devcontainer-shell-history\\nsource /workspaces/coding_agent/.devcontainer/shell-history.sh\\n' >> ~/.bashrc; }",

  "remoteEnv": {
    "OLLAMA_BASE_URL": "http://host.docker.internal:11434",
    "LITELLM_BASE_URL": "http://litellm:4000/v1",
    "LITELLM_API_KEY": "${localEnv:LITELLM_API_KEY}"
  },

  // ---------------------------------------------------------------------------
  // VS Code extensions installed automatically inside the container.
  // ---------------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        // Python language support
        "ms-python.python",
        "ms-python.vscode-pylance",
        // Linter / formatter (matches ruff in pyproject.toml)
        "charliermarsh.ruff",
        // Static type checking (matches mypy in pyproject.toml)
        "ms-python.mypy-type-checker",
        // TOML editing (pyproject.toml)
        "tamasfe.even-better-toml",
        // Dotenv file highlighting
        "mikestead.dotenv",
        "GitHub.copilot-chat"
      ],
      "settings": {
        // Point the Python extension at the uv-managed virtual environment.
        "python.defaultInterpreterPath": "/workspaces/coding_agent/.venv/bin/python",
        // Use ruff as the default formatter.
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  }
}
