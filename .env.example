# Values in this file are loaded by python-dotenv and expanded from
# ${VAR} references in config/config.yaml. Configure the application in YAML.

# ─── Model provider ────────────────────────────────────────────────────────────
# LiteLLM example. Change the provider fields in config/config.yaml for other
# providers or a local OpenAI-compatible endpoint.
API_KEY_LITELLM=

# ─── Discord bot ───────────────────────────────────────────────────────────────
# Create a bot at https://discord.com/developers/applications.
DISCORD_BOT_TOKEN=

# ─── Heartbeat output ──────────────────────────────────────────────────────────
HEARTBEAT_OUTPUT_ADAPTER=
HEARTBEAT_OUTPUT_CHANNEL=

# ─── Matrix bot ────────────────────────────────────────────────────────────────
# Create a bot account on your homeserver. Obtain an access token via:
#   curl -XPOST 'https://<homeserver>/_matrix/client/v3/login' \
#        -H 'Content-Type: application/json' \
#        -d '{"type":"m.login.password","user":"<user>","password":"<pass>"}'
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=@bot:matrix.org
MATRIX_DEVICE_ID=
MATRIX_STORE_PATH=./nio_store

# ─── Optional tools ────────────────────────────────────────────────────────────
# Tavily web search — https://app.tavily.com/
# If set, the agent gains a live web_search tool automatically.
TAVILY_API_KEY=

# ─── LangSmith Tracing (optional but recommended) ──────────────────────────────
# https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=agent-dev
